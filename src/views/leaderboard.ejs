<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width">
    <title>Range Explanations</title>
    <link rel="stylesheet" href="/css/leaderboard.css">
</head>
<body>
    <div class="container">
        <%- include('partials/username-display') %>

        <h1>Range Explanations</h1>
        <table id="tabla">
            <thead>
            <tr>
                <th>Range</th>
                <th>Badge</th>
                <th>Required Bitpoints</th>
            </tr>
            </thead>
            <tbody id="table-body">
            <% badges.forEach(badge => { %>
                <tr>
                    <td><%= badge.rango %></td>
                    <td>
                        <img
                                src="<%= badge.svg %>"
                                alt="<%= badge.rango %>"
                                width="50">
                    </td>
                    <td><%= badge.bitpoints_min %> - <%= badge.bitpoints_max %></td>
                </tr>
            <% }); %>
            </tbody>
        </table>
    </div>
</body>
</html>
