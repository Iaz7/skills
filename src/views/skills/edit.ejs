<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/edit_skill.css">
    <title>Skill Editor: <%= skill.id %> - SW_2425</title>
</head>
<body>
<div class="content">
    <h1>Edit Skill: Learn to use a breadboard</h1>

    <div class="skill-container">
        <div class="svg-wrapper">
            <svg width="100" height="100" viewBox="0 0 100 100">
                <polygon points="50,0 100,25 100,75 50,100 0,75 0,25" fill="white" stroke="black" stroke-width="1" />
                <text x="50%" y="35%" text-anchor="middle" fill="black" font-size="9">
                    <%
                    const words = skill.text.split(' ');
                    let line = '';
                    let lines = [];

                    words.forEach(word => {
                        if ((line + ' ' + word).trim().length <= 20) {
                            line += (line ? ' ' : '') + word;
                        } else {
                            lines.push(line);
                            line = word;
                        }
                    });
                    if (line) lines.push(line);

                    lines.forEach((line, index) => {
                    %>
                        <tspan x="50%" dy="<%= index === 0 ? '0' : '1.2em' %>"><%= line %></tspan>
                    <% }) %>
                </text>
                <image x="35%" y="60%" width="30" height="30" href="<%= skill.icon %>" />
            </svg>
        </div>

        <form action="/skills/<%= skill.set %>/edit/<%= skill._id %>" method="POST" enctype="multipart/form-data">
            <label for="text">Skill Text:</label>
            <textarea id="text" name="text" rows="2" required><%= skill.text %></textarea>

            <label for="description">Description:</label>
            <textarea id="description" name="description" rows="3" required><%= skill.description %></textarea>

            <label for="tasks">Tasks to Complete (one per line):</label>
            <textarea id="tasks" name="tasks" rows="3" required><%= skill.tasks.reduce((taskString, currentTask) => taskString += currentTask + "\n", "").trimEnd() %></textarea>

            <label for="resources">Resources (one per line):</label>
            <textarea id="resources" name="resources" rows="3" required><%= skill.resources.reduce((resourceString, currentResource) => resourceString += currentResource + "\n", "").trimEnd() %></textarea>

            <label for="score">Skill Score:</label>
            <input type="number" id="score" name="score" min="1" max="10" value="<%= skill.score %>" required>

            <label for="icon">Upload Icon (30x30 png):</label>
            <input type="file" id="icon" name="icon" accept="image/svg">

            <div class="button-group">
                <button type="submit" class="save-btn">Save</button>
                <a href="/skills/<%= skill.set %>"><button type="button" class="cancel-btn">Cancel</button></a>
                <button type="button" class="delete-btn" id="delete">Delete</button>
            </div>
        </form>
    </div>
</div>
<script>
    document.getElementById('delete').addEventListener('click', () => {
        if (confirm('Are you sure you want to delete this skill?')) {
            fetch('/skills/<%= skill.set %>/delete/<%= skill._id %>', {
                method: 'POST'
            }).then((res) => {
                if (res.ok) window.location.href = '/skills/<%= skill.set %>';
                else alert('Failed to delete skill, error code: ' + res.status);
            });
        };
    });
</script>
</body>
</html>