<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/edit_skill.css">
    <title>Add skill - SW_2425</title>
</head>
<body>
    <%- include('../partials/username-display') %>
    <div class="content">
        <h1>Add Skill</h1>

    <div class="skill-container">

        <form action="/skills/<%= skillTree %>/add" method="POST" enctype="multipart/form-data">
            <label for="text">Skill Text:</label>
            <textarea id="text" name="text" rows="2"></textarea>

            <label for="description">Description:</label>
            <textarea id="description" name="description" rows="3"></textarea>

            <label for="tasks">Tasks to Complete (one per line):</label>
            <textarea id="tasks" name="tasks" rows="3"></textarea>

            <label for="resources">Resources (one per line):</label>
            <textarea id="resources" name="resources" rows="3"></textarea>

            <label for="score">Skill Score:</label>
            <input type="number" id="score" name="score" min="1" max="10">

            <label for="icon">Upload SVG:</label>
            <input type="file" id="icon" name="icon" accept="image/svg+xml">

            <div class="button-group">
                <button type="submit" class="save-btn">Save</button>
                <a href="/skills/<%= skillTree %>"><button type="button" class="cancel-btn">Cancel</button></a>
            </div>
        </form>
    </div>
</div>
</body>
</html>