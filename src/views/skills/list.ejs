<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/skills/list.css">
    <title><%= skillTree %> - Skill Tree</title>
</head>
<body>
    <h1>Skill Tree: <%= skillTree %></h1>

    <script>const descriptions = {}</script>

    <div style="display: flex; justify-content: center; align-items: center; margin-top: 50px;">
        <a href="/skills/<%= skillTree%>/add"><button style="width: 100px; height: 50px">Add skill</button></a>
    </div>

    <div class="svg-container">
        <% skills.forEach(skill => { %>
            <script>
                descriptions['<%= skill._id%>'] = '<%= skill.description%>';
            </script>
            <div class="svg-wrapper" id="<%= skill._id %>">
                <svg width="100" height="100" viewBox="0 0 100 100">
                        <defs>
                          <linearGradient id="gradient-red" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color: #ff8787; stop-opacity: 1" />
                            <stop offset="100%" style="stop-color: #d32323; stop-opacity: 1" />
                          </linearGradient>
                          <linearGradient id="gradient-green" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color: #7efb7e; stop-opacity: 1" />
                            <stop offset="100%" style="stop-color: #397f39; stop-opacity: 1" />
                          </linearGradient>
                    </defs>
                    <polygon points="50,5 95,27.5 95,72.5 50,95 5,72.5 5,27.5" class="hexagon" <% if (userSkills.find(userSkill => userSkill.skill.equals(skill._id) && userSkill.user.equals(user))?.verified) {%> style="fill: #5ac35a"<%}%>/>

                    <circle cx="15" cy="15" r="10" class="hex-circle hex-circle-red" />
                    <text x="15" y="20" text-anchor="middle" fill="white" font-size="10" font-weight="bold">
                        <%= userSkills.filter(userSkill => userSkill.skill.equals(skill._id) && !userSkill.verified).length;  %>
                    </text>
                    <circle cx="85" cy="15" r="10" class="hex-circle hex-circle-green" />
                    <text x="85" y="20" text-anchor="middle" fill="white" font-size="10" font-weight="bold">
                        <%= userSkills.find(userSkill => userSkill.skill.equals(skill._id) && userSkill.user.equals(user))?.verifications.filter(verification => verification.approved).length ?? 0  %>
                    </text>

                    <text x="50%" y="35%" text-anchor="middle" fill="black" font-size="9">
                        <%
                        const words = skill.text.split(' ');
                        let line = '';
                        let lines = [];

                        words.forEach(word => {
                            if ((line + ' ' + word).trim().length <= 20) {
                                line += (line ? ' ' : '') + word;
                            } else {
                                lines.push(line);
                                line = word;
                            }
                        });
                        if (line) lines.push(line);

                        lines.forEach((line, index) => {
                            %>
                            <tspan x="50%" dy="<%= index === 0 ? '0' : '1.2em' %>"><%= line %></tspan>
                        <% }) %>
                    </text>

                    <image x="35%" y="60%" width="30" height="30" href="<%= skill.icon %>" />
                </svg>

                <button class="icon-button left-button"><a href="/skills/<%= skillTree %>/edit/<%= skill._id %>">✏️</a></button>
                <button class="icon-button right-button"><a href="/skills/<%= skillTree %>/view/<%= skill._id %>">📕</a></button>
            </div>
        <% }) %>
    </div>

    <footer id="descripcion" hidden>Descripcion</footer>

    <script>
        const svgWrappers = document.getElementsByClassName('svg-wrapper');
        for (let wrapper of svgWrappers) {
            wrapper.addEventListener('mouseover', () => {
                wrapper.classList.add('highlight');
                const desc = document.getElementById('descripcion');
                desc.textContent = descriptions[wrapper.getAttribute('id')];
                desc.removeAttribute('hidden');
            });
            wrapper.addEventListener('mouseout', () => {
                wrapper.classList.remove('highlight');
                document.getElementById('descripcion').setAttribute('hidden', '');
            });
        }
    </script>
</body>
</html>