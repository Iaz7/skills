<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/skills/view.css">
    <title><%= skill.id %> @ Skill Details - SW_2425</title>
    <script src="/js/view_skill.js"></script>
</head>
<body>
    <%- include('../partials/username-display') %>

    <div class="content">
        <h1>Skill: <%= skill.text %></h1>
        <div class="svg-wrapper">
            <svg width="100" height="100" viewBox="0 0 100 100">
                <polygon points="50,0 100,25 100,75 50,100 0,75 0,25" fill="white" stroke="black" stroke-width="1" />
                <text x="50%" y="35%" text-anchor="middle" fill="black" font-size="9">
                    <% 
                    const words = skill.text.split(' ');
                    let line = '';
                    let lines = [];
                    
                    words.forEach(word => {
                        if ((line + ' ' + word).trim().length <= 20) {
                            line += (line ? ' ' : '') + word;
                        } else {
                            lines.push(line);
                            line = word;
                        }
                    });
                    if (line) lines.push(line);

                    lines.forEach((line, index) => { 
                    %>
                        <tspan x="50%" dy="<%= index === 0 ? '0' : '1.2em' %>"><%= line %></tspan>
                    <% }) %>
                </text>
                <image x="35%" y="60%" width="30" height="30" href="<%= skill.icon %>" />
            </svg>
        </div>
        <h2>Skill Score: <%= skill.score %> point<%= (skill.score > 1 || skill.score === 0) ? 's' : ''%></h2>
        <h2>Description</h2>
        <p><%= skill.description %></p>
        <h2 id="task-title">Tasks to Complete</h2>
        <% if (skill.tasks.length === 0) { %>
            <p>No tasks to complete.</p>
        <% } else { %>
            <ul>
                <% skill.tasks.forEach(task => { %>
                    <li>
                        <input class="checkbox" type="checkbox" id="<%= task %>" name="tasks" value="<%= task %>">
                        <label for="<%= task %>"><%= task %></label>
                    </li>
                <% }); %>
            </ul>
        <% } %>

        <div id="oculto" hidden>
            <h2>Provide Evidence</h2>
            <form>
                <textarea name="evidence" id="textbox" placeholder="Enter a URL or explanation as evidence for completing this skill"></textarea>
                <button class="button-green" id="submit">Submit Evidence</button>
            </form>
        </div>
        <script>
            const skillId = "<%= skill._id %>";
            const skillTree = "<%= skill.set %>";
            const userSkills = <%- JSON.stringify(userSkills) %>;
            const user = "<%= user.id %>";
        </script>

        <h2>Resources</h2>
        <% if (skill.resources.length === 0) { %>
            <p>No resources available.</p>
        <% } else { %>
            <ul id="resources">
                <% skill.resources.forEach(resource => { %>
                    <li><%= resource %></li>
                <% }); %>
            </ul>
        <% } %>

        <div class="content">
            <h1>Unverified evidence submissions</h1>
            <table id="submissions-table">
                <thead>
                <tr>
                    <th>User</th>
                    <th>Evidence</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                <!-- Mostrar user skills que no estén ya aproobadas y que no hayan sido ya verificadas por el usuario-->
                <% userSkills.filter(userSkill => !userSkill.approved && !userSkill.verifications.some(verification => verification.user.equals(user.id))).forEach(userSkill => { %>
                    <tr>
                        <td><%= userSkill.user.username %></td>
                        <td><%= userSkill.evidence %></td>
                        <td>
                            <button class="button-green" onclick="postVerification('<%= userSkill._id %>', true)">Approve</button>
                            <button class="button-red" onclick="postVerification('<%= userSkill._id %>', false)">Reject</button>
                        </td>
                    </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>