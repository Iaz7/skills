<style>
    .navbar {
        background-color: #ebd76e;
        padding: 10px;
        border-radius: 5px;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .navbar ul {
        display: flex;
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .navbar li {
        font-family: 'Arial', sans-serif;
        margin: 0 10px;
    }
    .navbar a {
        font-family: 'Arial', sans-serif;
        text-decoration: none;
        font-weight: bold;
        color: #003eff;
    }

    @media (max-width: 768px) {
        .navbar {
            flex-direction: column;
            align-items: flex-start;
        }
        .navbar ul {
            flex-direction: column;
            width: 100%;
        }
        .navbar li {
            margin: 5px 0;
            width: 100%;
            text-align: left;
        }
        .navbar a {
            display: block;
            width: 100%;
        }
    }
</style>

<div class="navbar">
    <ul>
        <% if (user) { %>
            <!-- Usuario autenticado -->
            <li>Welcome, <%= user.username %>!</li>
            <li><a href="/skills">electronics</a></li>
            <li><a href="/users/leaderboard">Leaderboard</a></li>
            <% if (user.admin) { %>
                <li><a href="/admin/dashboard">Admin Panel</a></li>
            <% } %>
            <li><a href="/users/logout">Logout</a></li>
        <% } else { %>
            <!-- Usuario no autenticado -->
            <li><a href="/users/login">Login</a></li>
        <% } %>
    </ul>
</div>